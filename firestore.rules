rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 보호자 한 명의 구글 계정 = 한 가족. 그 계정으로 로그인한 기기만 자기 가족 기록을 읽고 쓴다.
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 아이·전집·규칙·관리 비밀번호
    match /families/{uid} {
      allow read, write: if owner(uid);

      // 읽은 책 기록 한 건씩
      match /logs/{logId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.id == logId
          && request.resource.data.review is string
          && request.resource.data.review.size() <= 100
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 200;
      }
    }

    // 그 밖에는 아무도 읽고 쓰지 못한다(다른 가족 목록 보기 포함).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
